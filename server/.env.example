# ── Echo (Deck's voice AI) ───────────────────────────────────────────────
# Echo talks to any OpenAI-compatible chat-completions API.
# Without a key it silently falls back to the built-in rule-based parser.
#
# Provider: openai | groq | openrouter | together | gemini | custom
# Leave unset and Echo infers it from whichever provider key you set.
ECHO_PROVIDER=openai
ECHO_API_KEY=sk-your-api-key
ECHO_MODEL=gpt-4o-mini
# Only needed for ECHO_PROVIDER=custom (or to override a provider's default):
# ECHO_BASE_URL=https://your-gateway.example.com/v1

# Generation tuning (all optional)
ECHO_TEMPERATURE=0.2
ECHO_MAX_TOKENS=1200
# Set to false for models that reject response_format=json_object
ECHO_JSON_MODE=true
# How long to wait for the model before falling back to rule-based parsing.
ECHO_TIMEOUT_MS=20000
# Extra attempts on timeouts and 429/5xx responses. 0 disables retrying.
ECHO_RETRIES=1

# Legacy aliases — still honoured so existing deployments keep working:
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o-mini
# VOICE_AI_TIMEOUT_MS=20000
# VOICE_AI_RETRIES=1

# Hour (0-23, in the user's own time zone) that dated voice reminders fire.
VOICE_REMINDER_HOUR=9
